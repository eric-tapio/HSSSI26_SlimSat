/**
 * @file slimsat_bus.h
 * @brief SlimSat Bus System Main Controller Header
 * 
 * @details This header file defines the SlimSatBus class which serves as the main
 * controller for the SlimSat bus system. It coordinates communication
 * between various subsystems including payload, LoRa radio, message handling,
 * and system database operations.
 * 
 * CAPE-Twiggs HSSSI-26 SlimSat Project
 * August 30, 2025
 * Copyright (c) 2025, Eric Tapio. All rights reserved.
 * Licensed under the MIT license. See LICENSE file in the project root for full license information.
 */

#ifndef SLIMSAT_BUS_HEADER
#define SLIMSAT_BUS_HEADER

// Adafruit TinyUSB is needed if running on the Adafruit ItsyBitsy. Otherwise it can be commented out 
//#include <Adafruit_TinyUSB.h> // for Serial
#include <payload.h>
#include <msg_circular_buffer.h>
#include <nmea_lite_msg_handler.h>
#include <simple_timer.h>
#include <lora_radio.h>
#include <bus_db.h>
#include <bus_data.h>
#include <payload_data.h>
#include <gps_if.h>


#define VERBOSE_BUS_OUTPUT 0

#define GS_FULL_HEADER_ID "$GS99"
#define STRNCMP_MATCHES_RESULT 0

#define MAX_SERIAL_TERM_BUFFER_CHARS (31+1)
#define USE_GPS_SENSOR 1

#define GET_CMD_INPUT_FROM_LORA_RADIO 0
#define TRANSMIT_RESPONSES_USING_LORA_RADIO 0

#define TEST_LORA_TRASMIT_MESSAGE "This is a test LoRa Message"
#define MULTI_MESSAGE_INTER_TRANSMISSION_DELAY_IN_MS 300


/**
 * @brief Main SlimSat Bus Controller Class
 * 
 * @details The SlimSatBus class serves as the central coordinator for all SlimSat
 * bus operations. It manages communication with the payload, handles
 * command processing, coordinates LoRa radio operations, and maintains system
 * timing and database operations. This class implements the main operational
 * loop for the bus system.
 */
class SlimSatBus {
private:
	// Data Members
	//uint8_t stream_data_mode; // Stream data mode flag

	// Serial Terminal Input data members
	char serial_term_received_chars[MAX_SERIAL_TERM_BUFFER_CHARS]; // Buffer for serial terminal received characters
	uint8_t serial_msg_data_index; // Current index in the serial receive buffer
	uint8_t new_serial_msg_rxd; // Flag indicating new command received
	uint8_t new_serial_msg_to_process; // Flag indicating new command ready to process
	
	int16_t radio_status_code;
	
	
	// Methods
	/**
	 * @brief Initialize serial terminal received characters buffer
	 * @details Clears all characters in the serial terminal receive buffer
	 */
	void initializeSerialTermReceivedChars(void);

public:
	// Data Member Objects
	BusDb Bus_database; // Spacecraft bus database object
	Payload Payload1; // Payload subsystem object
	NmeaMsgHandler Msg_handler; // NMEA message handler object
	SimpleTimer Payload_timer; // Timer for payload operations
	SimpleTimer Beacon_timer; // Timer for beacon transmissions
	SimpleTimer Bus_timer; // Timer for recording bus data
	LoRaRadio LoRa; // LoRa radio communication object
	BusDataRec Bus_data;
	PlDataRec Pl_data;
	GpsIf Gps;

	// Constructors
	/**
	 * @brief Default constructor for SlimSatBus
	 * @details Initializes all subsystem objects and sets up default configuration
	 */
	SlimSatBus(void);

	// Methods
	/**
	 * @brief Perform one iteration of bus operations
	 * @details Executes the main operational loop including command checking,
	 * command handling, and response transmission
	 */
	void performBusOperationIteration(void);
	
	/**
	 * @brief Initialize the bus system
	 * @details Performs initialization of all bus subsystems and prepares
	 * the system for normal operations
	 */
	void initializeBus(void);

	/**
	 * @brief Transmit beacon message
	 * @details Sends the beacon message containing system status
	 * and identification information
	 */
	void transmitBeaconMessage(void);

	/**
	 * @brief Get bus commands
	 * @details Checks for incoming commands from serial terminal
	 * and processes them for handling
	 */
	char* getBusCmdFromSerialTerm(void);
	
	/**
	 * @brief Get bus commands
	 * @details Checks for incoming commands from LoRa radio
	 * and processes them for handling
	 */	
	char* getReceivedMsgFromLoraRadio(void);

	/**
	 * @brief Handle bus commands
	 * @details Processes received commands and generates appropriate responses
	 * using the NMEA message handler
	 */
	//void handleBusCmd(void);
	void handleBusCmd(char* bus_cmd_msg);

	/**
	 * @brief Print bus object information
	 * @details Outputs diagnostic information about the bus state
	 * and subsystem status for debugging purposes
	 */
	void print(void) const;
	
	/**
	 * @brief Perform payload operations
	 * @details Executes payload-specific operations including data streaming
	 * and command processing based on current system mode
	 */
	void performPayloadOp(void);

	// Serial Terminal Input methods
	/**
	 * @brief Get input from serial terminal
	 * @details Reads characters from the serial port and buffers them
	 * until a complete command is received
	 */
	void getSerialTermInput(void);

	/**
	 * @brief Display new serial terminal data
	 * @details Shows newly received serial terminal data for debugging
	 * and confirmation purposes
	 */
	void displayNewSerialTermData(void);
	
	void initializePinStates(void);
	int16_t startLoRa(void);
	uint8_t recordBusData(void);
	void startGps(void);
	
	void getInputFromSerialTerm(void);

	void transmitResponseMessages(void);
	void transmitMessageToLoraRadio(char* msg);
	void transmitMessageToLoraRadio(const char* msg);

	void transmitMessageUsingSerialTerm(char* msg);
	
	void transmitMessageFromSerialTermToLoraRadio(void);
	void transmitResponseMessageFromLoraRadioToSerialTerm(void);
	
	void transmitLoraRadioTestMessage(void);
	void getReceivedRadioMessage(void);
	char* getReceivedMsgFromLoraRadioUsingInterrupt(void);
	void getReceivedMsgFromLoraRadioUsingBlocking(void);
	
	
	uint8_t CmdMsgIsForGs(char* msg);
	void performGsOperationIteration(void);
	
	void performPartialPayloadOp(void);
	uint8_t recordPartialBusData(void);
	
};

#endif