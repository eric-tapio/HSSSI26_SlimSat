// Adafruit TinyUSB is needed if running on the Adafruit ItsyBitsy. Otherwise it can be commented out 
#include <Adafruit_TinyUSB.h> // for Serial
#include <flash_memory_if.h>"

// Construct the S/C Flash Memory IF Object
FlashMemoryIf ScFlashMemIf;

void setup() {
  // Open a serial port for SlimSat communication
  Serial.begin(115200);
  while (!Serial) {
		delay(10);   
	}

	Serial.println(F(" ~ Running SlimSat Flash Memory Interface ..."));
}

void loop() {
	// Exercise the various SlimSat S/C Flash Memory Interface methods

	ScFlashMemIf.print();

	Serial.println("");
	
	Serial.println(ScFlashMemIf.getScBusTimeInMs());
	ScFlashMemIf.setScBusEpochTimeInMs(12345);
	Serial.println(ScFlashMemIf.getScBusEpochTimeInMs());

	Serial.println(F("\n ~ Done."));
  
	delay(30000);
}



//
//  main.cpp
//  Flash_Memory
//
//  Created by Ellora Horan on 11/2/25.
//

#include <iostream>
using namespace std;

FlashMemoryIf flashMem;

int main(void) {

    cout << " ~ Running Flash Memory Class ..." << endl << endl;

    flashMem.print();


	uint32_t next_write_to_adr = flashMem.getNextWriteToAddress();
    uint32_t next_read_from_adr = flashMem.getNextReadFromAddress();

    flashMem.flashEraseBlock(0x00000000);
    //cout << flashMem.getCurrentIndex() << endl << endl;
    //cout << flashMem.getLastIndex() << endl << endl;

	float float_val = 3.1425;
	flashMem.writeValueToFlashAddress(4, float_val);

	uint16_t uint16_val = 65530;
    flashMem.writeValueToFlashAddress(10, uint16_val);

    flashMem.writeValueToFlashAddress(20, 'A');

	double double_val = 6.2830;
    flashMem.writeValueToFlashAddress(30, double_val);

	long long_val = 123456789;
    flashMem.writeValueToFlashAddress(40, long_val);

    return EXIT_SUCCESS;
}
